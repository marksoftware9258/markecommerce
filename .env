APP_NAME="Laravel API Boilerplate"
APP_ENV=local
APP_KEY=base64:9xeZAdfRn+w19XjancWBsQOAYHUOsDNvXT/LY3l8UIo=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# API
API_VERSION=v1
API_PREFIX=api
API_RATE_LIMIT=60
API_RATE_LIMIT_LOGIN=5

# Pagination
PAGINATION_DEFAULT=15
PAGINATION_MAX=100

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_api
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# JWT
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# OTP
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Two Factor Auth
TWO_FACTOR_ENABLED=false
TWO_FACTOR_EXPIRY_MINUTES=5

# Password Reset
PASSWORD_RESET_EXPIRY_MINUTES=60

# File Upload
MAX_FILE_SIZE_KB=2048
ALLOWED_IMAGE_TYPES="jpg,jpeg,png,webp"

CORS_ALLOWED_ORIGINS="*"
